{
  "extraKnownMarketplaces": {
    "eng-kit": { "source": { "source": "github", "repo": "rkaliev/eng-kit" } }
  },
  "enabledPlugins": { "eng-kit@eng-kit": true },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)"
    ]
  }
}
